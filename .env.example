# Öffentliche URL der Webseite (ohne abschliessenden Slash).
# Wird für Metadata, sitemap.xml, robots.txt und OG-Tags verwendet.
NEXT_PUBLIC_SITE_URL=https://www.example.ch

# Suchmaschinen erlauben (true/false). Erst auf true setzen, wenn
# Impressum und Datenschutzerklärung vollständig sind.
NEXT_PUBLIC_ALLOW_INDEXING=false
